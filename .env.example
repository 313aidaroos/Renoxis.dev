NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
CONNECTION_ENCRYPTION_KEY=

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# This site's Wallet client name, printed next to WALLET_API_KEY by `npm run family-keys`.
APIXIS_CLIENT_ID=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Sign in with Apixis redirect. Only if this site's domain differs from the one in create-family-keys.
APIXIS_REDIRECT_URI=
# Public site URL, e.g. https://<site>.vercel.app
NEXT_PUBLIC_SITE_URL=
# Developer scripts only (not Vercel)
# Local SQL test script only (must be unset). Not needed on Vercel.
# DATABASE_URL=
# Local SQL test script only. Not needed on Vercel.
# PGHOST=
# Local SQL test script only. Not needed on Vercel.
# PGPASSWORD=
# Local SQL test script only. Not needed on Vercel.
# PGPORT=
# Local SQL test script only (must be unset). Not needed on Vercel.
# PGSERVICE=
# Local SQL test script only. Not needed on Vercel.
# PGUSER=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=
# Alternate name for NEXT_PUBLIC_SUPABASE_ANON_KEY. Set one of them.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternate name for SUPABASE_SERVICE_ROLE_KEY. Set one of them.
# SUPABASE_SECRET_KEY=

# Added 2026-09-28 (Grok Developer Bot): automatic Apixis world agent for new accounts.
# This site's key for Apixis.dev POST /api/agent/provision (server only). Apixis.dev keeps its SHA-256.
APIXIS_WORLD_KEY=
# Optional. Default https://www.apixis.dev
# APIXIS_WORLD_API=

# Card checkout on the live Apixis.dev Stripe account. Leave unset until the Prices exist.
# Server only. Never commit values. Names only:
# STRIPE_SECRET_KEY — creates Checkout Sessions
# STRIPE_WEBHOOK_SECRET — verifies Stripe-Signature on /api/stripe/webhook
# STRIPE_PRICE_START_FEE — one-time start fee Price id (START_FEE in lib/renoxis/pricing.ts)
# STRIPE_PRICE_MONTHLY_PROMO — monthly Price id used while now is before PROMO_END
# STRIPE_PRICE_MONTHLY_STANDARD — monthly Price id used from PROMO_END on, and the price a promo subscription switches to
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START_FEE=
STRIPE_PRICE_MONTHLY_PROMO=
STRIPE_PRICE_MONTHLY_STANDARD=
